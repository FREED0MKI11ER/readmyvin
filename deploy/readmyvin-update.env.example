# Configuration for readmyvin-update.sh (installed to /etc/default/readmyvin-update).
# Uncomment/override any value as needed.
#
# Deploys are driven by the release tag (e.g. v1.2.1). Bump the repo's VERSION
# file and push to publish a new release; the server picks it up within 10 min.

# GitHub repository that hosts the "latest" release with the deploy bundle.
READMYVIN_REPO=FREED0MKI11ER/readmyvin

# Where the last-deployed release tag is recorded.
#READMYVIN_STATE=/var/lib/readmyvin/deployed.version

# Directory Caddy serves the site from.
READMYVIN_WEBROOT=/var/www/vindecoder

# systemd unit that runs the Go backend.
READMYVIN_SERVICE=vindecoder

# Filename of the Go binary inside the webroot (must match the unit's ExecStart).
READMYVIN_BINARY=counter

# Health-check URL used to confirm the service came back up.
READMYVIN_HEALTH_URL=http://127.0.0.1:8097/counter
